<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HLSL compute on the GPU through Windows' built-in Direct3D 11 (d3d11.dll) and HLSL compiler (d3dcompiler_47.dll).
    No packages: COM is called through vtable function pointers. Every kernel has a CPU reference implementation
    (Cpu*.cs) used for parity tests and as the fallback on non-Windows machines (CI).
  -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Trademaster.Telemetry\Trademaster.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Shaders\*.hlsl" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
